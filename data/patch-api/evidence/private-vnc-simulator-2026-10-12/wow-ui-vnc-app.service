[Unit]
Description=Bounded retail WoW UI simulator on private VNC display :22
Requires=wow-ui-vnc-display.service
After=wow-ui-vnc-display.service

[Service]
Type=exec
WorkingDirectory=/home/osso/Projects/wow/wow-ui-sim
Environment=DISPLAY=:22
Environment=XAUTHORITY=/home/osso/.local/state/wow-ui-sim/vnc-simulator/Xauthority
Environment=VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.json
Environment=WGPU_BACKEND=vulkan
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=LP_NUM_THREADS=2
Environment=WOW_SIM_NO_SOUND=1
UnsetEnvironment=WAYLAND_DISPLAY
ExecStart=/home/osso/.local/state/wow-ui-sim/verification/bounty-set-maps-current/default-green-compile-20261012T025403623595Z/wow-sim-sealed --no-addons --no-saved-vars
CPUQuota=200%
MemoryMax=4G
RuntimeMaxSec=90
KillMode=control-group
TimeoutStopSec=5
