[Unit]
Description=Private WoW UI simulator X display :22

[Service]
Type=exec
ExecStart=/usr/bin/Xvfb :22 -screen 0 1280x960x24 -nolisten tcp -auth /home/osso/.local/state/wow-ui-sim/vnc-simulator/Xauthority
ExecStartPost=/usr/bin/python3 /home/osso/.local/state/wow-ui-sim/vnc-simulator/wait-display.py
CPUQuota=50%
MemoryMax=512M
KillMode=control-group
TimeoutStopSec=5
