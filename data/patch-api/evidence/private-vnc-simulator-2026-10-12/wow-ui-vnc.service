[Unit]
Description=Private simulator VNC on 127.0.0.1:5904
Requires=wow-ui-vnc-display.service
After=wow-ui-vnc-display.service

[Service]
Type=exec
ExecStart=/usr/bin/x11vnc -display :22 -auth /home/osso/.local/state/wow-ui-sim/vnc-simulator/Xauthority -localhost -listen 127.0.0.1 -rfbport 5904 -nopw -forever -shared
CPUQuota=50%
MemoryMax=256M
KillMode=control-group
TimeoutStopSec=5
