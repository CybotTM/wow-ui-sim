{"type":"error","executed":"from pathlib import Path\nimport datetime, hashlib, json, random, time\n\nREPO = Path('/home/osso/Projects/wow/wow-ui-sim')\nROOT = Path('/home/osso/.local/state/wow-ui-sim/verification/quest-currency-war-mode-current')\n\ndef save(epoch, name, value):\n    (epoch / name).write_text(json.dumps(value, indent=2, sort_keys=True) + '\\n')\n\ndef observe_capacity():\n    memory = {line.split(':')[0]: int(line.split(':')[1].split()[0]) for line in Path('/proc/meminfo').read_text().splitlines()}\n    load = float(Path('/proc/loadavg').read_text().split()[0])\n    active = []\n    for process in Path('/proc').iterdir():\n        if not process.name.isdigit():\n            continue\n        try:\n            if (process / 'comm').read_text().strip() == 'cargo' and (process / 'cwd').resolve() in [REPO, REPO.parent / 'full-suite-checkout']:\n                active.append(process.name)\n        except OSError:\n            continue\n    available = memory['MemAvailable'] / 1048576\n    return {'at': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'load1': load, 'available_gib': available, 'relevant_cargo': active, 'admitted': available >= 6 and load < 24 and not active}\n\ndef record_toolchain(epoch):\n    versions = {}\n    for name, argv in [('cargo', ['/usr/bin/cargo', '-V']), ('rustc', ['/usr/bin/rustc', '-Vv'])]:\n        value = cli.command(*argv).capture().run()\n        versions[name] = {'argv': argv, 'exit': value.exit_code, 'stdout': value.stdout, 'stderr': value.stderr}\n        if value.exit_code != 0:\n            raise RuntimeError('Failed to inspect ' + name + ' toolchain')\n    save(epoch, 'toolchain.json', versions)\n\ndef select_integration_record(stdout):\n    records = [json.loads(line) for line in stdout.splitlines()]\n    selected = [record for record in records if record.get('reason') == 'compiler-artifact' and record.get('target', {}).get('name') == 'integration' and record.get('executable')]\n    if len(selected) != 1:\n        raise RuntimeError('Expected one integration compiler artifact, got ' + str(len(selected)))\n    return selected[0]\n\ndef seal_new_artifact(epoch, record):\n    source = Path(record['executable'])\n    binary = epoch / 'integration-sealed'\n    payload = source.read_bytes()\n    binary.write_bytes(payload)\n    binary.chmod(0o555)\n    save(epoch, 'artifact.json', {'source': str(source), 'path': str(binary), 'bytes': len(payload), 'sha256': hashlib.sha256(payload).hexdigest(), 'cargo_record': record})\n\ndef compile_phase(phase, expected_revision):\n    epoch = ROOT / (phase + '-compile-' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ'))\n    epoch.mkdir()\n    observations = []\n    for attempt in range(6):\n        admission = observe_capacity()\n        observations.append(admission)\n        save(epoch, 'admission-history.json', observations)\n        if admission['admitted']:\n            break\n        if attempt < 5:\n            time.sleep(min(30 * 2 ** attempt, 180) + random.uniform(0, 3))\n    save(epoch, 'admission.json', admission)\n    if not admission['admitted']:\n        save(epoch, 'outcome.json', {'status': 'RESOURCE_BLOCKED', 'phase': phase, 'executed_cases': 0})\n        raise RuntimeError('Quest currency War Mode ' + phase + ' compilation admission denied')\n    revision = cli.git('-C', str(REPO), 'rev-parse', 'HEAD').capture().run()\n    diff = cli.git('-C', str(REPO), 'diff', expected_revision, '--', 'src', 'tests', 'Cargo.toml', 'Cargo.lock').capture().run()\n    save(epoch, 'source-applicability.json', {'base': expected_revision, 'head': revision.stdout.strip(), 'diff_exit': diff.exit_code, 'diff_stdout': diff.stdout, 'diff_stderr': diff.stderr})\n    if revision.exit_code != 0 or diff.exit_code != 0 or diff.stdout:\n        raise RuntimeError('Quest currency War Mode relevant source changed before compilation')\n    test_source = REPO / 'tests/quest_currency_war_mode.rs'\n    source_before = test_source.read_bytes()\n    save(epoch, 'revision.json', {'head': revision.stdout.strip(), 'test_commit': expected_revision, 'phase': phase, 'test_source_sha256': hashlib.sha256(source_before).hexdigest(), 'scope': 'Consolidated PvP profile gate; affected13-case Quest caller and normal publication only; flag9 proof reused unchanged'})\n    record_toolchain(epoch)\n    argv = ['/usr/bin/cargo', 'test', '--test', 'integration', '--no-run', '--message-format=json', '--offline', '--locked', '-j', '12'] + PROFILE_ARGS\n    save(epoch, 'compile-submission.json', {'argv': argv, 'cwd': str(REPO), 'scope': 'One new integration build for changed currency query test phase; no full-suite or build deadline'})\n    value = cli.command(*argv).cwd(str(REPO)).capture().run()\n    (epoch / 'compile.stdout').write_text(value.stdout)\n    (epoch / 'compile.stderr').write_text(value.stderr)\n    save(epoch, 'compile-result.json', {'exit': value.exit_code, 'source_unchanged': source_before == test_source.read_bytes()})\n    if value.exit_code != 0:\n        save(epoch, 'outcome.json', {'status': 'COMPILE_FAILED', 'phase': phase, 'executed_cases': 0})\n        raise RuntimeError('Quest currency War Mode ' + phase + ' compilation failed')\n    if source_before != test_source.read_bytes():\n        raise RuntimeError('Quest currency War Mode source changed during compilation')\n    seal_new_artifact(epoch, select_integration_record(value.stdout))\n    save(epoch, 'outcome.json', {'status': 'COMPILED_NOT_EXECUTED', 'phase': phase, 'executed_cases': 0})\n    print(str(epoch))\n    return epoch\n\ndef require_admission(epoch, name):\n    observations = []\n    for attempt in range(6):\n        admission = observe_capacity()\n        observations.append(admission)\n        save(epoch, name + '-admission-history.json', observations)\n        if admission['admitted']:\n            save(epoch, name + '-admission.json', admission)\n            return\n        if attempt < 5:\n            time.sleep(min(30 * 2 ** attempt, 180) + random.uniform(0, 3))\n    save(epoch, name + '-blocked.json', {'status': 'RESOURCE_BLOCKED', 'executed_cases': 0})\n    raise RuntimeError(name + ' admission denied')\n\nNORMAL_SCRIPT = \"\"\"local queries = {\n    {C_PvP, 'IsWarModeDesired', false},\n    {C_PvP, 'GetWarModeRewardBonus', 10},\n    {C_QuestLog, 'QuestCanHaveWarModeBonus', false, 901001},\n    {C_CurrencyInfo, 'GetFactionGrantedByCurrency', nil, 90001},\n}\nfor _, row in ipairs(queries) do\n    local f = rawget(row[1], row[2])\n    assert(type(f) == 'function', row[2] .. ' raw publication')\n    assert(select('#', f(row[4])) == 1, row[2] .. ' one result')\n    assert(f(row[4]) == row[3], row[2] .. ' unseeded state')\nend\nassert(C_PvP.GetWarModeRewardBonusDefault() == 10)\nfor _, f in ipairs({C_QuestLog.QuestCanHaveWarModeBonus, C_CurrencyInfo.GetFactionGrantedByCurrency}) do\n    local ok, message = pcall(f, '90001')\n    assert(not ok and string.find(message, 'number', 1, true), 'strict numeric relation')\nend\"\"\"\n\ndef execute_green_profile(epoch):\n    require_admission(epoch, 'runtime')\n    artifact = json.loads((epoch / 'artifact.json').read_text())\n    argv = ['/usr/bin/timeout', '90', artifact['path'], 'quest_currency_war_mode::', '--nocapture', '--test-threads=1']\n    save(epoch, 'runtime-submission.json', {'argv': argv, 'cwd': str(REPO), 'scope': '13 new query and real QuestUtils consumer cases'})\n    result = cli.command(*argv).cwd(str(REPO)).env('WOW_SIM_CASC', '0').env('WOW_SIM_NO_SOUND', '1').capture().run()\n    (epoch / 'runtime.stdout').write_text(result.stdout)\n    (epoch / 'runtime.stderr').write_text(result.stderr)\n    save(epoch, 'runtime-outcome.json', {'exit': result.exit_code})\n    if result.exit_code != 0:\n        raise RuntimeError('Quest GREEN failed; later stages not executed')\n    records = [json.loads(line) for line in (epoch / 'compile.stdout').read_text().splitlines()]\n    candidates = [row for row in records if row.get('reason') == 'compiler-artifact' and row.get('target', {}).get('name') == 'wow-sim' and row.get('executable') and not row.get('profile', {}).get('test')]\n    if len(candidates) != 1:\n        raise RuntimeError('Expected one normal wow-sim artifact')\n    record = candidates[0]\n    source = Path(record['executable'])\n    binary = epoch / 'wow-sim-sealed'\n    payload = source.read_bytes()\n    binary.write_bytes(payload)\n    binary.chmod(0o555)\n    save(epoch, 'normal-artifact.json', {'source': str(source), 'path': str(binary), 'bytes': len(payload), 'sha256': hashlib.sha256(payload).hexdigest(), 'cargo_record': record})\n    require_admission(epoch, 'normal')\n    argv = ['/usr/bin/timeout', '90', str(binary), '--no-addons', '--no-saved-vars', '--exec-lua', NORMAL_SCRIPT, 'lua-errors']\n    save(epoch, 'normal-submission.json', {'argv': argv, 'cwd': str(REPO), 'scope': 'Normal loaded four raw getter publication/arity/unseeded input/strict type and unchanged Default; startup Lua errors'})\n    result = cli.command(*argv).cwd(str(REPO)).env('WOW_SIM_NO_SOUND', '1').capture().run()\n    (epoch / 'normal.stdout').write_text(result.stdout)\n    (epoch / 'normal.stderr').write_text(result.stderr)\n    save(epoch, 'normal-outcome.json', {'exit': result.exit_code, 'stdout': result.stdout})\n    if result.exit_code != 0 or result.stdout.strip() != '[]':\n        raise RuntimeError('Normal Quest startup/publication failed')\n    save(epoch, 'green-outcome.json', {'status': 'EXECUTED', 'profile_cases': 13, 'runtime_exit': 0, 'normal_exit': 0})\n\ndef run_final_quest_checks():\n    epoch = ROOT / ('check-' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ'))\n    epoch.mkdir()\n    require_admission(epoch, 'final-check')\n    paths = ['src/c_api/item_spell/c_currency.rs', 'src/lua_api/state.rs', 'src/lua_api/state/sim_state.rs', 'tests/currency_war_mode_bonus.rs', 'tests/quest_currency_war_mode.rs', 'src/c_api/helpers.rs', 'src/c_api/c_pvp.rs', 'src/c_api/c_pvp/war_mode.rs', 'src/c_api/c_quest_log.rs', 'src/c_api/mod.rs', 'src/lua_api/globals/missing_surface/small_namespaces.rs', 'src/lua_api/globals/quest_surface/register.rs', 'Cargo.toml', 'Cargo.lock']\n    before = {name: hashlib.sha256((REPO / name).read_bytes()).hexdigest() for name in paths}\n    revision = cli.git('-C', str(REPO), 'rev-parse', 'HEAD').capture().run()\n    save(epoch, 'revision.json', {'head': revision.stdout.strip(), 'sources_before': before})\n    results = []\n    for name, argv in [('fmt', ['/usr/bin/cargo', 'fmt', '--check']), ('check', ['/usr/bin/cargo', 'check', '--offline', '--locked', '-j', '12'])]:\n        save(epoch, name + '-submission.json', {'argv': argv, 'cwd': str(REPO)})\n        result = cli.command(*argv).cwd(str(REPO)).capture().run()\n        (epoch / (name + '.stdout')).write_text(result.stdout)\n        (epoch / (name + '.stderr')).write_text(result.stderr)\n        save(epoch, name + '-result.json', {'exit': result.exit_code})\n        results.append({'name': name, 'exit': result.exit_code})\n    after = {name: hashlib.sha256((REPO / name).read_bytes()).hexdigest() for name in paths}\n    save(epoch, 'outcome.json', {'status': 'EXECUTED', 'results': results, 'sources_unchanged': before == after, 'sources_after': after})\n    print(str(epoch))\n\nPROFILE_ARGS=[]\nepoch=compile_phase('retail-profile-gate', '91324b10380f9be3e8d196491e9a2d20bc597fa1')\nexecute_green_profile(epoch)\nPROFILE_ARGS=['--no-default-features','--features','sound,gui,casc,client-ptr']\nepoch=compile_phase('ptr-profile-gate', '91324b10380f9be3e8d196491e9a2d20bc597fa1')\nexecute_green_profile(epoch)\nrun_final_quest_checks()\n","console":[],"error":"Error: Quest currency War Mode retail-profile-gate compilation admission denied"}
