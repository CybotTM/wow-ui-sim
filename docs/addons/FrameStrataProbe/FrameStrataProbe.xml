<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="FrameStrataProbeBaseHighTemplate" frameStrata="HIGH" virtual="true"/>
    <Frame name="FrameStrataProbeDerivedParentTemplate"
           inherits="FrameStrataProbeBaseHighTemplate"
           frameStrata="PARENT"
           virtual="true"/>
    <Frame name="FrameStrataProbeDerivedLowTemplate"
           inherits="FrameStrataProbeBaseHighTemplate"
           frameStrata="LOW"
           virtual="true"/>

    <!-- Group 0: direct PARENT effective result, before any mutations. -->
    <Frame name="FrameStrataProbeCreationParent" parent="UIParent" frameStrata="DIALOG" hidden="true"/>
    <Frame name="FrameStrataProbeCreationParentChild"
           parent="FrameStrataProbeCreationParent"
           frameStrata="PARENT"
           hidden="true">
        <Scripts>
            <OnLoad>
                FrameStrataProbeParentChildOnLoad = {
                    frameStrata = self:GetFrameStrata(),
                    parentFrameStrata = self:GetParent():GetFrameStrata(),
                    hasFixedFrameStrata = self:HasFixedFrameStrata(),
                }
            </OnLoad>
        </Scripts>
    </Frame>
    <Frame name="FrameStrataProbeCreationLiteralChild"
           parent="FrameStrataProbeCreationParent"
           frameStrata="LOW"
           hidden="true">
        <Scripts>
            <OnLoad>
                FrameStrataProbeLiteralChildOnLoad = {
                    frameStrata = self:GetFrameStrata(),
                    parentFrameStrata = self:GetParent():GetFrameStrata(),
                    hasFixedFrameStrata = self:HasFixedFrameStrata(),
                }
            </OnLoad>
        </Scripts>
    </Frame>

    <!-- Group 1: values before and after parent SetFrameStrata. -->
    <Frame name="FrameStrataProbeParentSetParent" parent="UIParent" frameStrata="HIGH" hidden="true"/>
    <Frame name="FrameStrataProbeParentSetParentChild"
           parent="FrameStrataProbeParentSetParent"
           frameStrata="PARENT"
           hidden="true"/>
    <Frame name="FrameStrataProbeParentSetDefaultChild"
           parent="FrameStrataProbeParentSetParent"
           hidden="true"/>
    <Frame name="FrameStrataProbeParentSetExplicitChild"
           parent="FrameStrataProbeParentSetParent"
           frameStrata="MEDIUM"
           hidden="true"/>
    <Frame name="FrameStrataProbeParentSetParentGrandchild"
           parent="FrameStrataProbeParentSetParentChild"
           frameStrata="PARENT"
           hidden="true"/>
    <Frame name="FrameStrataProbeParentSetExplicitGrandchild"
           parent="FrameStrataProbeParentSetDefaultChild"
           frameStrata="MEDIUM"
           hidden="true"/>

    <!-- Group 2: values before and after SetParent, using separate fixtures. -->
    <Frame name="FrameStrataProbeReparentHigh" parent="UIParent" frameStrata="HIGH" hidden="true"/>
    <Frame name="FrameStrataProbeReparentLow" parent="UIParent" frameStrata="LOW" hidden="true"/>
    <Frame name="FrameStrataProbeReparentParentChild"
           parent="FrameStrataProbeReparentHigh"
           frameStrata="PARENT"
           hidden="true"/>
    <Frame name="FrameStrataProbeReparentDefaultChild"
           parent="FrameStrataProbeReparentHigh"
           hidden="true"/>
    <Frame name="FrameStrataProbeReparentExplicitChild"
           parent="FrameStrataProbeReparentHigh"
           frameStrata="MEDIUM"
           hidden="true"/>
    <Frame name="FrameStrataProbeReparentParentGrandchild"
           parent="FrameStrataProbeReparentParentChild"
           frameStrata="PARENT"
           hidden="true"/>
    <Frame name="FrameStrataProbeReparentExplicitGrandchild"
           parent="FrameStrataProbeReparentDefaultChild"
           frameStrata="MEDIUM"
           hidden="true"/>

    <!-- Three distinct values: base HIGH, derived LOW, actual parent DIALOG. -->
    <Frame name="FrameStrataProbeTemplateActualParent"
           parent="UIParent"
           frameStrata="DIALOG"
           hidden="true"/>
    <Frame name="FrameStrataProbeTemplateBase"
           parent="FrameStrataProbeTemplateActualParent"
           inherits="FrameStrataProbeBaseHighTemplate"
           hidden="true"/>

    <!-- Compare the PARENT template result with the derived literal control. -->
    <Frame name="FrameStrataProbeTemplateParent"
           parent="FrameStrataProbeTemplateActualParent"
           inherits="FrameStrataProbeDerivedParentTemplate"
           hidden="true"/>
    <Frame name="FrameStrataProbeTemplateDerivedLow"
           parent="FrameStrataProbeTemplateActualParent"
           inherits="FrameStrataProbeDerivedLowTemplate"
           hidden="true"/>
</Ui>
